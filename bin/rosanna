#!/usr/bin/env php
<?php

declare(strict_types=1);

// パッケージのルートで実行した場合と、依存として入った場合 (RT-13.1)
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (file_exists($autoload)) {
        require $autoload;
        break;
    }
}

$help = static function (): void {
    echo <<<'HELP'
        Rosanna CLI

        Usage:
          rosanna <command>

        Commands:
          compile    Compile .psx files into the cache directory and generate the manifest
          help       Show this help message

        Compile options:
          rosanna compile [options] [paths...]

          Paths are files or directories (default: ./components). A path that does not
          exist is an error.

          --check               Verify compiled files are up to date, without writing them (CI use)
          --clean               Remove the contents of the cache directory
          --watch               Recompile when a .psx file changes (Ctrl+C to stop)
          --cache=PATH          Cache directory for compiled files and the manifest
                                (default: ./var/cache/psx)

        Examples:
          ./vendor/bin/rosanna compile components/
          ./vendor/bin/rosanna compile --check

        HELP;
    echo "\n";
};

$compile = static function (array $arguments): int {
    // CP-140
    return new \Polidog\Rosanna\Psx\CompileCommand()->run($arguments, getcwd() ?: '.');
};

$command = $argv[1] ?? 'help';

switch ($command) {
    case 'compile':
        exit($compile(array_slice($argv, 2)));

    case 'help':
        $help();
        exit(0);

    default:
        // RT-13.9
        fwrite(STDERR, "Unknown command: {$command}\n\n");
        $help();
        exit(1);
}
