{
    "name": "polidog/rosanna",
    "description": "Server-side PHP components in the shape of React: H, Element, Renderer and the PSX compiler",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "polidog",
            "email": "polidogs@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "nikic/php-parser": "^5.7"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "vimeo/psalm": "^6.14"
    },
    "autoload": {
        "psr-4": {
            "Polidog\\Rosanna\\": "src/"
        },
        "files": [
            "src/Html/Elements.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Polidog\\Rosanna\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/rosanna"
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "0.0.x-dev"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "psalm": "psalm --no-progress",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
